AWS_ACCESS_KEY_ID=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
CORS_ORIGINS=
DATABASE_URL=
# PG_POOL_MAX=   # laisser commente pour garder la valeur par defaut
# Autorite de certification de l'hebergeur, si elle n'est pas publique.
# Chemin d'un fichier .crt, ou contenu PEM (les \n litteraux sont acceptes).
# Indispensable pour Supabase : sans elle, « self-signed certificate in
# certificate chain » et bascule sur la base embarquee. Voir SUPABASE.md.
# DATABASE_SSL_CA=

# Dossier de la base PostgreSQL embarquee (PGlite), utilisee quand
# DATABASE_URL est vide ou injoignable.
#   vide (defaut) -> .data/pglite, les donnees survivent au redemarrage
#   :memory:      -> base volatile assumee, tout est perdu a l'arret
# En NODE_ENV=test la base est toujours en memoire, quelle que soit la valeur.
# PGLITE_DATA_DIR=

# URL publique de l'application (liens envoyés par e-mail, ex. https://app.washpilot.ci)
APP_URL=
# Durée de validité d'un lien de réinitialisation de mot de passe, en minutes (défaut 60)
# PASSWORD_RESET_TTL_MINUTES=   # laisser commente pour garder la valeur par defaut

# Duree de l'essai gratuit offert a l'inscription, en jours (1 a 90).
# 14 par defaut. Sert a accorder plus de temps a un prospect important sans
# toucher au code. La page de tarifs annonce automatiquement cette valeur :
# elle ne peut donc pas promettre 14 jours quand le serveur en donne 30.
# Les essais deja ouverts gardent l'echeance calculee a leur inscription.
# TRIAL_DAYS=14
# Envoi des e-mails transactionnels via Resend. Sans clé, les liens sont journalisés
# côté serveur (et renvoyés dans la réponse API hors production uniquement).
RESEND_API_KEY=
MAIL_FROM=

# --- Encaissement des abonnements ---------------------------------------
# `manual` (défaut) : aucun contrat marchand. Le client paie hors application
# en mentionnant la référence qu'on lui donne, puis déclare son paiement ;
# vous validez depuis le back-office. Un code d'agrégateur (ex. `cinetpay`)
# basculerait l'activation en automatique via webhook.
PAYMENT_PROVIDER=manual
# Numéro marchand mobile money affiché au client, et nom du bénéficiaire.
# Sans eux, le client ne sait pas où envoyer son paiement.
PAYMENT_MERCHANT_NUMBER=
PAYMENT_MERCHANT_NAME=

# --- Back-office de l'éditeur -------------------------------------------
# Amorçage des administrateurs de /console (séparés par des virgules). Ces
# comptes vivent dans platform_operators, jamais dans les comptes de station.
# Une adresse d'amorçage retirée est désactivée au redémarrage ; les comptes
# créés ensuite depuis Console > Opérateurs ne dépendent plus de cette liste.
PLATFORM_ADMIN_EMAILS=
# Mot de passe initial de ces seuls comptes d'amorçage, lu à leur création.
# Vide : un secret aléatoire est affiché une seule fois dans les journaux.
# Les autres comptes et réinitialisations se gèrent depuis /console/operateurs.
PLATFORM_ADMIN_PASSWORD=

# Jeu de démonstration (station « Cocody Riviera », comptes @washpilot.ci).
# Jamais actif en production. Mettre `false` sur une base réelle : sinon les
# comptes de démonstration, dont le mot de passe est public, sont recréés à
# chaque démarrage.
# SEED_DEMO_DATA=false

# --- Neon Auth (facultatif) ---------------------------------------------
# Accepte, en plus des sessions maison, les jetons JWT signés par Neon Auth.
# Voir NEON-AUTH.md. Sans NEON_AUTH_JWKS_URL, la fonctionnalité est éteinte et
# le comportement reste inchangé (e-mail + mot de passe uniquement).
# L'émetteur (`iss`) est déduit de l'URL du JWKS : inutile de le déclarer,
# sauf pour imposer une autre valeur.
# NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
# NEON_AUTH_ISSUER=
# Audience (`aud`) attendue. Vide : le champ n'est pas contrôlé.
# NEON_AUTH_AUDIENCE=

# --- Assistance ---------------------------------------------------------
# Numéro WhatsApp affiché dans le bouton d'aide, au format international.
# Laissé vide hors production, un numéro de démonstration est affiché.
SUPPORT_WHATSAPP=
# Adresse e-mail de l'assistance (recours secondaire et destinataire des
# demandes d'activation de forfait).
SUPPORT_EMAIL=

# --- Relances d'échéance d'abonnement -----------------------------------
# Relances automatiques J-3, J-1 et à l'expiration de l'essai (true par défaut).
# REMINDERS_ENABLED=   # laisser commente pour garder la valeur par defaut
# Intervalle du planificateur, en minutes (5 à 1440, défaut 60).
# REMINDERS_INTERVAL_MINUTES=   # laisser commente pour garder la valeur par defaut
#
# Hébergement serverless (Vercel) : aucun processus ne vit assez longtemps pour
# porter un minuteur. Les relances sont alors déclenchées par le cron de la
# plateforme, qui appelle /api/v1/cron/reminders avec ce secret en
# « Authorization: Bearer ». Vide = la route refuse de s'exécuter.
# Doit être identique à la variable CRON_SECRET du tableau de bord Vercel.
CRON_SECRET=

# --- Alertes proactives de surveillance ---------------------------------
# Fréquence d'évaluation, en minutes (défaut 5). Les seuils et destinataires
# se règlent dans Console > Surveillance > Alertes proactives.
# MONITORING_ALERT_INTERVAL_MINUTES=5
# E-mail : réutilise RESEND_API_KEY et MAIL_FROM ci-dessus.
# WhatsApp Cloud API : un modèle approuvé à DEUX variables est obligatoire
# (1 = titre de l'alerte, 2 = détail), car une alerte sort du fenêtrage 24 h.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v22.0
WHATSAPP_ALERT_TEMPLATE=
# WHATSAPP_ALERT_TEMPLATE_LANGUAGE=fr

# --- Rapprochement des relevés d'agrégateur -----------------------------
# Import CSV/JSON manuel disponible sans ces variables dans /console/rapprochement.
# Pour le connecteur planifié : endpoint HTTPS renvoyant un tableau JSON
# (entries/data) ou un CSV. Les paramètres from/to ISO sont ajoutés à l'URL.
# Le rapprochement marque les correspondances et ouvre des écarts ; il
# n'active jamais un abonnement et ne modifie aucun montant du registre.
# RECONCILIATION_ENABLED=false
RECONCILIATION_PROVIDER=
RECONCILIATION_STATEMENT_URL=
# Jeton Bearer facultatif pour lire le relevé ; jamais enregistré dans la base.
RECONCILIATION_STATEMENT_TOKEN=
# RECONCILIATION_LOOKBACK_HOURS=24

# --- Sauvegarde ---------------------------------------------------------
# Dossier de destination de scripts/db-backup.sh (défaut ./backups)
BACKUP_DIR=
# Nombre de jours de conservation des sauvegardes locales (défaut 30)
RETENTION_DAYS=

# --- Déploiement par docker compose -----------------------------------------
# Ces variables ne servent qu'à « docker compose » (voir docker-compose.yml).
# En dehors de ce cadre, seule DATABASE_URL compte.
#
# ATTENTION : la composition refuse de démarrer sans POSTGRES_PASSWORD. C'est
# volontaire — une base de production ne doit pas avoir de mot de passe par
# défaut, surtout un mot de passe écrit dans un fichier d'exemple public.
POSTGRES_DB=washpilot
POSTGRES_USER=washpilot
POSTGRES_PASSWORD=
# Port exposé sur la machine hôte. Derrière un répartiteur, gardez 3000.
APP_PORT=3000
